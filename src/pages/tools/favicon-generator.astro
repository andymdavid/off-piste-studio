---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<SiteLayout bodyAttributes={{"data-page-type":"tool","data-page-slug":"favicon-generator","data-theme":"dark"}}>
<Fragment slot="head" is:raw>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="description" content="Free favicon generator. Upload any image and generate favicons for all platforms — browser tabs, Apple touch icons, Android home screen, and PWA splash screens. Download as PNG.">
  <title>Free Favicon Generator — All Sizes for Every Platform | Off Piste Studio</title>
  <link rel="canonical" href="https://offpistestudio.com/tools/favicon-generator">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Free Favicon Generator — All Sizes for Every Platform | Off Piste Studio">
  <meta property="og:description" content="Upload any image and generate favicons for browser tabs, Apple touch icons, Android, and PWA. Download individually as PNG.">
  <meta property="og:url" content="https://offpistestudio.com/tools/favicon-generator">
  <meta property="og:site_name" content="Off Piste Studio">
  <meta property="og:image" content="https://offpistestudio.com/images/Hero-Background.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Free Favicon Generator — All Sizes for Every Platform | Off Piste Studio">
  <meta name="twitter:description" content="Upload any image and generate favicons for browser tabs, Apple touch icons, Android, and PWA.">
  <meta name="twitter:image" content="https://offpistestudio.com/images/Hero-Background.png">
  <script type="application/ld+json" is:inline="">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "SoftwareApplication",
        "name": "Favicon Generator",
        "description": "Upload any image and generate favicons at every size needed for modern websites — 16x16, 32x32, 48x48, 180x180 Apple touch icon, 192x192 Android, and 512x512 PWA. Free, instant, no signup required.",
        "url": "https://offpistestudio.com/tools/favicon-generator",
        "applicationCategory": "DesignApplication",
        "operatingSystem": "Web",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "AUD"
        },
        "author": {
          "@type": "Organization",
          "name": "Off Piste Studio",
          "url": "https://offpistestudio.com"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What sizes do I need for a favicon?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Modern websites need favicons at multiple sizes: 16x16 and 32x32 for browser tabs, 48x48 for Windows site icons, 180x180 for Apple touch icons on iOS, 192x192 for Android home screen shortcuts, and 512x512 for Progressive Web App splash screens. This tool generates all of them from a single image."
            }
          },
          {
            "@type": "Question",
            "name": "What image format should I upload?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You can upload PNG, JPG, WebP, or SVG images. For best results, use a square image at least 512x512 pixels. PNG with a transparent background is ideal for favicons, as it preserves transparency across all generated sizes."
            }
          },
          {
            "@type": "Question",
            "name": "How do I add favicons to my website?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Download the generated favicons and place them in your website's root directory or an images folder. Then add the generated HTML link tags to the <head> section of your HTML. This tool provides the exact HTML snippet you need — just copy and paste it."
            }
          },
          {
            "@type": "Question",
            "name": "Why does my favicon look blurry?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Blurry favicons usually result from uploading a low-resolution source image. Start with the largest, highest-quality version of your logo — ideally at least 512x512 pixels. SVG files work best as they scale without quality loss. Avoid using photographs as favicons, as they lose detail at small sizes."
            }
          }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://offpistestudio.com/" },
          { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://offpistestudio.com/tools" },
          { "@type": "ListItem", "position": 3, "name": "Favicon Generator", "item": "https://offpistestudio.com/tools/favicon-generator" }
        ]
      }
    ]
  }
  </script>
  
  
  
  
  
  
  
</Fragment>
<Fragment is:raw>
  </Fragment><Header /><Fragment is:raw>

  <main>
    <section class="tool-hero">
      <div class="container">
        <h1 class="tool-hero__title">Favicon Generator</h1>
        <p class="tool-hero__subtitle">Upload any image and generate favicons for every platform — browser tabs, Apple touch icons, Android, and PWA. Free, no signup required.</p>
        <a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="hero-intro__button work-hero__button tool-hero__button">Book a Free Discovery Call</a>
      </div>
    </section>

    <section class="tool-spacer" aria-label="Tool section">
      <div class="container">
        <div class="tool-spacer__row">
          <h2 class="tool-spacer__heading">Tool</h2>
        </div>
      </div>
    </section>

    <section class="tool-app">
      <div class="container">
        <div class="favicon-generator">
          <!-- Dropzone -->
          <div class="brand-extractor__dropzone" id="dropzone">
            <input type="file" id="file-input" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden="">
            <div class="brand-extractor__dropzone-content">
              <svg class="brand-extractor__dropzone-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              <p class="brand-extractor__dropzone-text">Drag and drop your image here</p>
              <p class="brand-extractor__dropzone-subtext">PNG, JPG, WebP, SVG · Square images work best</p>
              <button class="brand-extractor__browse" id="browse-btn" type="button">Browse Files</button>
            </div>
          </div>

          <!-- Image preview -->
          <div class="brand-extractor__preview" id="image-preview" hidden="">
            <img id="preview-image" alt="Uploaded source image">
            <button class="brand-extractor__reset" id="reset-btn" type="button">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              New Image
            </button>
          </div>

          <!-- Results -->
          <div id="favicon-results" hidden="">
            <h2 class="favicon-generator__title">Generated Favicons</h2>

            <div class="favicon-grid" id="favicon-grid"></div>

            <!-- HTML snippet -->
            <div class="favicon-generator__snippet">
              <div class="brand-extractor__export-header">
                <span class="tool-label">HTML Snippet</span>
                <button class="tool-copy-btn" id="copy-snippet" type="button">Copy</button>
              </div>
              <pre class="brand-extractor__export-code"><code id="snippet-code"></code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="tool-spacer" aria-label="How to use this tool">
      <div class="container">
        <div class="tool-spacer__row">
          <h2 class="tool-spacer__heading">How it works</h2>
        </div>
      </div>
    </section>

    <!-- SEO content -->
    <section class="tool-content">
      <div class="container">
        <div class="tool-content__body">
          <div class="tool-content__main">
          <h2>How to Use This Tool</h2>
          <p>Upload your logo or icon by dragging it onto the dropzone or clicking "Browse Files". The tool instantly generates favicons at six standard sizes used by browsers, mobile devices, and Progressive Web Apps. Each size is rendered using high-quality canvas scaling for crisp results.</p>
          <p>Download each favicon individually using the download buttons, then add the generated HTML snippet to your website's &lt;head&gt; section. For best results, start with a square image at least 512x512 pixels — SVG files produce the sharpest output at all sizes.</p>

          <h2>Why Favicons Matter</h2>
          <p>A favicon is the small icon that appears in browser tabs, bookmarks, mobile home screens, and search results. It's one of the first visual cues that identifies your brand online. Without a favicon, your site shows a generic browser icon — making it harder for users to find your tab among many open pages.</p>
          <p>Modern websites need favicons at multiple sizes because different devices and contexts use different resolutions. A 16x16 icon suits a browser tab, but an Apple device needs 180x180 for the home screen touch icon, and Progressive Web Apps require 512x512 for splash screens. This tool generates all the sizes you need from a single source image.</p>
          </div>
          <aside class="tool-content__related" aria-labelledby="related-tools-heading">
            <h2 id="related-tools-heading">Related Tools</h2>
            <div class="tool-related">
            <a href="/tools/brand-color-extractor" class="tool-related__link">
              <span class="tool-related__name">Brand Colour Extractor</span>
              <span class="tool-related__desc">Upload your logo and extract brand colours with hex codes</span>
            </a>
            <a href="/tools/contrast-checker" class="tool-related__link">
              <span class="tool-related__name">Contrast Checker</span>
              <span class="tool-related__desc">Check if your colours meet WCAG accessibility standards</span>
            </a>
          </div>
          </aside>
        </div>
      </div>
    </section>


    <section class="faq-duplicate faq-duplicate--tool">
      <div class="container">
        <div class="faq-duplicate__grid">
          <div class="faq-duplicate__row faq-duplicate__row--blank" aria-hidden="true">
            <div class="faq-duplicate__blank-cell"></div>
          </div>

          <div class="faq-duplicate__row faq-duplicate__row--title">
            <div class="faq-duplicate__title-cell faq-duplicate__title-cell--left">
              <h2 class="segments__heading">FAQ</h2>
            </div>
          </div>

          <div class="faq-duplicate__row faq-duplicate__row--blank" aria-hidden="true">
            <div class="faq-duplicate__blank-cell"></div>
          </div>

          <div class="faq-duplicate__row faq-duplicate__row--list">
            <div class="faq-duplicate__list-wrap">
              <section class="faq section page-faq">
                <div class="container">
                  <div class="faq__layout">
                    <div class="faq__list">
            <details class="faq__item">
              <summary class="faq__question">What sizes do I need for a favicon?</summary>
              <p class="faq__answer">Modern websites need favicons at multiple sizes: 16x16 and 32x32 for browser tabs, 48x48 for Windows site icons, 180x180 for Apple touch icons on iOS, 192x192 for Android home screen shortcuts, and 512x512 for Progressive Web App splash screens. This tool generates all of them from a single image.</p>
            </details>
            <details class="faq__item">
              <summary class="faq__question">What image format should I upload?</summary>
              <p class="faq__answer">You can upload PNG, JPG, WebP, or SVG images. For best results, use a square image at least 512x512 pixels. PNG with a transparent background is ideal for favicons, as it preserves transparency across all generated sizes.</p>
            </details>
            <details class="faq__item">
              <summary class="faq__question">How do I add favicons to my website?</summary>
              <p class="faq__answer">Download the generated favicons and place them in your website's root directory or an images folder. Then add the generated HTML link tags to the &lt;head&gt; section of your HTML. This tool provides the exact HTML snippet you need — just copy and paste it.</p>
            </details>
            <details class="faq__item">
              <summary class="faq__question">Why does my favicon look blurry?</summary>
              <p class="faq__answer">Blurry favicons usually result from uploading a low-resolution source image. Start with the largest, highest-quality version of your logo — ideally at least 512x512 pixels. SVG files work best as they scale without quality loss. Avoid using photographs as favicons, as they lose detail at small sizes.</p>
            </details>
                    </div>
                  </div>
                </div>
              </section>
            </div>
          </div>

          <div class="faq-duplicate__row faq-duplicate__row--blank-bottom" aria-hidden="true">
            <div class="faq-duplicate__blank-cell"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="page-cta">
      <div class="container">
        <div class="page-cta__content">
          <h2 class="page-cta__heading">Need a website that looks polished on every device?</h2>
          <p class="page-cta__text">We build websites with every detail considered — from favicons to performance to accessibility. Get in touch to discuss your project.</p>
          <a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="hero-intro__button work-hero__button page-cta__button">Book a Discovery Call</a>
        </div>
      </div>
    </section>
  </main>

  </Fragment><Footer /><Fragment is:raw>

  
  


</Fragment>

<script src="/src/js/tools/favicon-generator.js"></script>
</SiteLayout>
