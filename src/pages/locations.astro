---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<SiteLayout bodyAttributes={{"data-page-type":"locations"}}><Fragment slot="head" is:raw>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="description" content="Explore Off Piste Studio web design services across Perth, Australia’s major cities, and local WA business communities.">
  <title>Web Design Locations Across Australia | Off Piste Studio</title>
  <link rel="canonical" href="https://offpistestudio.com/locations">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Web Design Locations Across Australia | Off Piste Studio">
  <meta property="og:description" content="Explore Off Piste Studio web design services across Perth, Australia’s major cities, and local WA business communities.">
  <meta property="og:url" content="https://offpistestudio.com/locations">
  <meta property="og:site_name" content="Off Piste Studio">
  <meta property="og:image" content="https://offpistestudio.com/images/Hero-Background.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Web Design Locations Across Australia | Off Piste Studio">
  <meta name="twitter:description" content="Explore Off Piste Studio web design services across Perth, Australia’s major cities, and local WA business communities.">
  <meta name="twitter:image" content="https://offpistestudio.com/images/Hero-Background.png">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Web Design Locations Across Australia",
    "url": "https://offpistestudio.com/locations",
    "description": "Off Piste Studio web design service locations across Australia.",
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": 15,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Adelaide", "url": "https://offpistestudio.com/locations/adelaide" },
        { "@type": "ListItem", "position": 2, "name": "Armadale", "url": "https://offpistestudio.com/locations/armadale" },
        { "@type": "ListItem", "position": 3, "name": "Brisbane", "url": "https://offpistestudio.com/locations/brisbane" },
        { "@type": "ListItem", "position": 4, "name": "Canning Vale", "url": "https://offpistestudio.com/locations/canning-vale" },
        { "@type": "ListItem", "position": 5, "name": "Fremantle", "url": "https://offpistestudio.com/locations/fremantle" },
        { "@type": "ListItem", "position": 6, "name": "Gold Coast", "url": "https://offpistestudio.com/locations/gold-coast" },
        { "@type": "ListItem", "position": 7, "name": "Joondalup", "url": "https://offpistestudio.com/locations/joondalup" },
        { "@type": "ListItem", "position": 8, "name": "Mandurah", "url": "https://offpistestudio.com/locations/mandurah" },
        { "@type": "ListItem", "position": 9, "name": "Melbourne", "url": "https://offpistestudio.com/locations/melbourne" },
        { "@type": "ListItem", "position": 10, "name": "Midland", "url": "https://offpistestudio.com/locations/midland" },
        { "@type": "ListItem", "position": 11, "name": "Osborne Park", "url": "https://offpistestudio.com/locations/osborne-park" },
        { "@type": "ListItem", "position": 12, "name": "Perth", "url": "https://offpistestudio.com/locations/perth" },
        { "@type": "ListItem", "position": 13, "name": "Rockingham", "url": "https://offpistestudio.com/locations/rockingham" },
        { "@type": "ListItem", "position": 14, "name": "Sydney", "url": "https://offpistestudio.com/locations/sydney" },
        { "@type": "ListItem", "position": 15, "name": "Wanneroo", "url": "https://offpistestudio.com/locations/wanneroo" }
      ]
    }
  }
  </script>
  
  
  
</Fragment><Fragment is:raw>
  </Fragment><Header /><Fragment is:raw>
  <main>
    <section class="work-hero">
      <div class="container">
        <h1 class="page-hero__title">Web Design Locations Across Australia</h1>
        <p class="page-hero__intro">Off Piste Studio helps businesses build a sharper digital presence from our home base in Perth to cities and local communities across Australia. Explore the location nearest you.</p>
        <a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="page-hero__button">Book a Discovery Call</a>
      </div>
    </section>
    <section class="page-body">
      <div class="container">
        <div class="page-body__content">
          <h2>Web design services by location</h2>
          <p>Choose a city or local area to learn how we approach websites, brand systems, local search visibility and lead generation for businesses in that market.</p>
        </div>
      </div>
    </section>
    <section class="page-links" aria-labelledby="location-list-heading">
      <div class="container">
        <div class="page-links__group">
          <h2 class="page-links__label" id="location-list-heading">Australia</h2>
          <div class="page-links__list">
            <a class="page-links__link" href="/locations/adelaide">Adelaide</a>
            <a class="page-links__link" href="/locations/armadale">Armadale</a>
            <a class="page-links__link" href="/locations/brisbane">Brisbane</a>
            <a class="page-links__link" href="/locations/canning-vale">Canning Vale</a>
            <a class="page-links__link" href="/locations/fremantle">Fremantle</a>
            <a class="page-links__link" href="/locations/gold-coast">Gold Coast</a>
            <a class="page-links__link" href="/locations/joondalup">Joondalup</a>
            <a class="page-links__link" href="/locations/mandurah">Mandurah</a>
            <a class="page-links__link" href="/locations/melbourne">Melbourne</a>
            <a class="page-links__link" href="/locations/midland">Midland</a>
            <a class="page-links__link" href="/locations/osborne-park">Osborne Park</a>
            <a class="page-links__link" href="/locations/perth">Perth</a>
            <a class="page-links__link" href="/locations/rockingham">Rockingham</a>
            <a class="page-links__link" href="/locations/sydney">Sydney</a>
            <a class="page-links__link" href="/locations/wanneroo">Wanneroo</a>
          </div>
        </div>
      </div>
    </section>
    <section class="page-cta">
      <div class="container"><div class="page-cta__content"><h2 class="page-cta__heading">Not sure which location applies?</h2><p class="page-cta__text">Tell us where your customers are and what you want your website to achieve.</p><a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="page-cta__button">Book a Discovery Call</a></div></div>
    </section>
  </main>
  </Fragment><Footer /><Fragment is:raw>
  


</Fragment></SiteLayout>