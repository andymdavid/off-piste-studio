{
  "name": "off-piste-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:insight-visuals": "node --test scripts/render-insight-visual.test.mjs",
    "verify:insight-visuals": "node scripts/verify-insight-visuals.mjs",
    "sync:insights": "node scripts/generate-insights.mjs",
    "sync:pages": "node scripts/generate-pages.mjs",
    "sync:sitemap": "node scripts/generate-sitemap.mjs",
    "sync": "npm run sync:insights && npm run sync:pages && npm run sync:sitemap",
    "dev": "npm run sync && astro dev --host 0.0.0.0",
    "build": "npm run sync && npm run verify:insight-visuals && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "start": "npm run dev",
    "check:site": "node scripts/check-built-site.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "lighthouse": "^13.6.0"
  },
  "dependencies": {
    "astro": "^7.4.7",
    "cheerio": "^1.2.0",
    "marked": "^17.0.4",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
