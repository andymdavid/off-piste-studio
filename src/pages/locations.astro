---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const locations = (await getCollection('locations')).map(({data}) => data).sort((a,b) => a.slug.localeCompare(b.slug));
const schema = {'@context':'https://schema.org','@type':'CollectionPage',name:'Web Design Locations Across Australia',url:new URL('/locations',Astro.site).href,description:'Off Piste Studio web design service locations across Australia.',mainEntity:{'@type':'ItemList',numberOfItems:locations.length,itemListElement:locations.map((page,index) => ({'@type':'ListItem',position:index+1,name:page.location,url:new URL(`/locations/${page.slug}`,Astro.site).href}))}};
---
<SiteLayout bodyAttributes={{"data-page-type":"locations"}}><Fragment slot="head" is:raw>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="description" content="Explore Off Piste Studio web design services across Perth, Australia’s major cities, and local WA business communities.">
  <title>Web Design Locations Across Australia | Off Piste Studio</title>
  <link rel="canonical" href="https://offpistestudio.com/locations">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Web Design Locations Across Australia | Off Piste Studio">
  <meta property="og:description" content="Explore Off Piste Studio web design services across Perth, Australia’s major cities, and local WA business communities.">
  <meta property="og:url" content="https://offpistestudio.com/locations">
  <meta property="og:site_name" content="Off Piste Studio">
  <meta property="og:image" content="https://offpistestudio.com/images/Hero-Background.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Web Design Locations Across Australia | Off Piste Studio">
  <meta name="twitter:description" content="Explore Off Piste Studio web design services across Perth, Australia’s major cities, and local WA business communities.">
  <meta name="twitter:image" content="https://offpistestudio.com/images/Hero-Background.png">
  </Fragment><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\u003c')} /><Fragment is:raw>
  
  
  
</Fragment><Fragment is:raw>
  </Fragment><Header /><Fragment is:raw>
  <main>
    <section class="work-hero">
      <div class="container">
        <h1 class="page-hero__title">Web Design Locations Across Australia</h1>
        <p class="page-hero__intro">Off Piste Studio helps businesses build a sharper digital presence from our home base in Perth to cities and local communities across Australia. Explore the location nearest you.</p>
        <a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="page-hero__button">Book a Discovery Call</a>
      </div>
    </section>
    <section class="page-body">
      <div class="container">
        <div class="page-body__content">
          <h2>Web design services by location</h2>
          <p>Choose a city or local area to learn how we approach websites, brand systems, local search visibility and lead generation for businesses in that market.</p>
        </div>
      </div>
    </section>
    <section class="page-links" aria-labelledby="location-list-heading">
      <div class="container">
        <div class="page-links__group">
          <h2 class="page-links__label" id="location-list-heading">Australia</h2>
          <div class="page-links__list">
            </Fragment>{locations.map(page => <a class="page-links__link" href={`/locations/${page.slug}`}>{page.location}</a>)}<Fragment is:raw>
          </div>
        </div>
      </div>
    </section>
    <section class="page-cta">
      <div class="container"><div class="page-cta__content"><h2 class="page-cta__heading">Not sure which location applies?</h2><p class="page-cta__text">Tell us where your customers are and what you want your website to achieve.</p><a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="page-cta__button">Book a Discovery Call</a></div></div>
    </section>
  </main>
  </Fragment><Footer /><Fragment is:raw>
  


</Fragment></SiteLayout>