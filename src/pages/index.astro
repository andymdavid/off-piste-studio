<script is:inline>
    (() => {
      if (document.body.dataset.pageType !== "duplicate-home") return;

      const storageKey = "off-piste-duplicate-theme";
      const toggle = document.querySelector("[data-theme-toggle]");
      const getStoredTheme = () => {
        try {
          return localStorage.getItem(storageKey);
        } catch {
          return null;
        }
      };

      const storeTheme = (theme) => {
        try {
          localStorage.setItem(storageKey, theme);
        } catch {
          // Ignore storage failures; the toggle should still work for the current page view.
        }
      };

      const setTheme = (theme) => {
        const nextTheme = theme === "light" ? "light" : "dark";
        const isLight = nextTheme === "light";

        document.body.dataset.theme = nextTheme;

        if (toggle) {
          toggle.setAttribute("aria-pressed", String(isLight));
          toggle.setAttribute("aria-label", isLight ? "Switch to dark mode" : "Switch to light mode");
        }
      };

      setTheme(getStoredTheme());

      toggle?.addEventListener("click", () => {
        const nextTheme = document.body.dataset.theme === "light" ? "dark" : "light";
        setTheme(nextTheme);
        storeTheme(nextTheme);
      });
    })();

    (() => {
      if (document.body.dataset.pageType !== "duplicate-home") return;

      const brand = document.querySelector(".footer__brand");
      const text = document.querySelector(".footer__brand-text");
      if (!brand || !text) return;

      let resizeTimer = 0;
      let hasAnimated = false;
      const label = text.textContent || "";

      const splitLetters = () => {
        text.innerHTML = "";

        Array.from(label).forEach((character, index) => {
          const letter = document.createElement("span");
          letter.className = character === " " ? "footer__brand-letter footer__brand-letter--space" : "footer__brand-letter";
          letter.style.setProperty("--footer-brand-letter-index", String(index));
          letter.textContent = character === " " ? "\u00a0" : character;
          text.appendChild(letter);
        });
      };

      const fitBrand = () => {
        if (!hasAnimated) brand.classList.remove("is-animated");
        text.style.setProperty("--footer-brand-scale", "1");

        const availableWidth = brand.getBoundingClientRect().width;
        const textWidth = text.getBoundingClientRect().width;
        if (!availableWidth || !textWidth) return;

        const scale = availableWidth / textWidth;
        text.style.setProperty("--footer-brand-scale", String(scale));
        brand.classList.add("is-fit");
      };

      const startAnimation = () => {
        if (hasAnimated) return;
        hasAnimated = true;
        window.requestAnimationFrame(() => {
          brand.classList.add("is-animated");
        });
      };

      const scheduleFit = () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          const wasAnimated = hasAnimated;
          fitBrand();
          hasAnimated = wasAnimated;
          if (wasAnimated) brand.classList.add("is-animated");
        }, 80);
      };

      splitLetters();

      if (document.fonts) {
        document.fonts.ready.then(fitBrand);
      } else {
        fitBrand();
      }

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          const entry = entries[0];
          if (!entry?.isIntersecting) return;

          observer.disconnect();
          if (document.fonts) {
            document.fonts.ready.then(startAnimation);
          } else {
            startAnimation();
          }
        }, { threshold: 0.35 });

        observer.observe(brand);
      } else {
        startAnimation();
      }

      window.addEventListener("resize", scheduleFit);
    })();

    (() => {
      const slider = document.querySelector("[data-testimonial-slider]");
      if (!slider) return;

      const slides = Array.from(slider.querySelectorAll("[data-testimonial-slide]"));
      const dots = Array.from(slider.querySelectorAll("[data-testimonial-dot]"));
      if (slides.length < 2 || slides.length !== dots.length) return;

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let activeIndex = 0;
      let timer = 0;

      const setActiveSlide = (nextIndex) => {
        activeIndex = (nextIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          slide.classList.toggle("is-active", index === activeIndex);
        });

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle("is-active", isActive);
          if (isActive) {
            dot.setAttribute("aria-current", "true");
          } else {
            dot.removeAttribute("aria-current");
          }
        });
      };

      const restartTimer = () => {
        window.clearInterval(timer);
        if (prefersReducedMotion) return;
        timer = window.setInterval(() => setActiveSlide(activeIndex + 1), 5200);
      };

      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          setActiveSlide(index);
          restartTimer();
        });
      });

      restartTimer();
    })();

    (() => {
      if (document.body.dataset.pageType !== "duplicate-home") return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const scrambleTargets = document.querySelectorAll(".footer__nav-link, .footer__contact-link, .testimonials__industries-item");
      const pathwayCards = document.querySelectorAll(".pathway");
      if (!scrambleTargets.length && !pathwayCards.length) return;

      const symbols = "{}[]<>/\\|01#$%&*=+_~";
      const duration = 280;
      const interval = 35;

      const bindScramble = (trigger, target, shouldLockWidth) => {
        const originalText = target.textContent || "";
        let timer = 0;
        let elapsed = 0;

        const restore = () => {
          window.clearInterval(timer);
          timer = 0;
          elapsed = 0;
          target.textContent = originalText;
          target.style.width = "";
          target.style.whiteSpace = "";
        };

        const scramble = () => {
          if (timer) return;

          if (shouldLockWidth) {
            const width = target.getBoundingClientRect().width;
            target.style.width = `${width}px`;
            target.style.whiteSpace = "nowrap";
          }

          timer = window.setInterval(() => {
            elapsed += interval;
            target.textContent = Array.from(originalText)
              .map((character) => {
                if (character === " ") return " ";
                return symbols[Math.floor(Math.random() * symbols.length)];
              })
              .join("");

            if (elapsed >= duration) restore();
          }, interval);
        };

        trigger.addEventListener("mouseenter", scramble);
        trigger.addEventListener("mouseleave", restore);
      };

      scrambleTargets.forEach((target) => {
        bindScramble(target, target, !target.classList.contains("testimonials__industries-item"));
      });

      pathwayCards.forEach((card) => {
        const title = card.querySelector(".pathway__title");
        if (!title) return;
        bindScramble(card, title, false);
      });

      const faqQuestions = document.querySelectorAll(".faq-duplicate .faq__question");

      faqQuestions.forEach((question) => {
        const item = question.closest(".faq__item");
        if (!item) return;

        const originalText = question.textContent || "";
        let timer = 0;
        let elapsed = 0;

        const restore = () => {
          window.clearInterval(timer);
          timer = 0;
          elapsed = 0;
          question.textContent = originalText;
          window.setTimeout(() => {
            item.classList.remove("is-click-animating");
          }, 120);
        };

        const scramble = () => {
          window.clearInterval(timer);
          timer = 0;
          elapsed = 0;
          item.classList.remove("is-click-animating");
          void item.offsetWidth;
          item.classList.add("is-click-animating");

          timer = window.setInterval(() => {
            elapsed += interval;
            question.textContent = Array.from(originalText)
              .map((character) => {
                if (character === " ") return " ";
                return symbols[Math.floor(Math.random() * symbols.length)];
              })
              .join("");

            if (elapsed >= duration) restore();
          }, interval);
        };

        question.addEventListener("click", scramble);
      });
    })();


    (() => {
      if (document.body.dataset.pageType !== "duplicate-home") return;

      const dock = document.querySelector("[data-lara-dock]");
      if (!dock) return;

      const toggle = dock.querySelector("[data-lara-toggle]");
      const panel = dock.querySelector(".lara-dock__panel");
      const close = dock.querySelector("[data-lara-close]");
      if (!toggle || !panel || !close) return;

      let lastFocusedElement = null;

      const openDock = () => {
        lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        dock.classList.add("is-open");
        panel.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        close.focus();
      };

      const closeDock = () => {
        dock.classList.remove("is-open");
        panel.hidden = true;
        toggle.setAttribute("aria-expanded", "false");

        if (lastFocusedElement instanceof HTMLElement) {
          lastFocusedElement.focus();
        }
      };

      toggle.addEventListener("click", () => {
        if (dock.classList.contains("is-open")) {
          closeDock();
          return;
        }

        openDock();
      });

      close.addEventListener("click", closeDock);

      dock.querySelectorAll(".lara-dock__choice, .lara-dock__ask, .lara-dock__tab[href]").forEach((link) => {
        link.addEventListener("click", () => {
          closeDock();
        });
      });

      document.addEventListener("click", (event) => {
        if (!dock.classList.contains("is-open")) return;
        if (dock.contains(event.target)) return;
        closeDock();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && dock.classList.contains("is-open")) {
          closeDock();
        }
      });
    })();
  </script>
