---
import { getCollection } from 'astro:content';
import BusinessPage from '../../layouts/BusinessPage.astro';
export async function getStaticPaths() {
  const routes = [];
  for (const section of ['industries', 'locations']) {
    for (const {data:page} of await getCollection(section)) routes.push({params:{section,slug:page.slug},props:{page,type:section === 'industries' ? 'industry' : 'location'}});
  }
  return routes;
}
const { page, type } = Astro.props;
---
<BusinessPage page={page} type={type} />
