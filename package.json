{
  "name": "off-piste-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:insight-visuals": "node --test scripts/render-insight-visual.test.mjs",
    "verify:insight-visuals": "node scripts/verify-insight-visuals.mjs",
    "sync:insights": "npm run build",
    "sync:pages": "npm run build",
    "sync:sitemap": "npm run build",
    "sync": "npm run build",
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && npm run verify:insight-visuals && node scripts/write-release.mjs && npm run check:site && npm run check:css",
    "preview": "astro preview --host 0.0.0.0",
    "start": "npm run dev",
    "check:site": "node scripts/check-built-site.mjs",
    "test:browser": "playwright test",
    "test:publishing": "node scripts/check-publishing.mjs",
    "test:publishing:dev": "node scripts/check-dev-publishing.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:css:parity": "node scripts/check-css-parity.mjs",
    "test:glyphs": "node --test scripts/glyph-states.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "lighthouse": "^13.6.0"
  },
  "dependencies": {
    "astro": "^7.4.7",
    "cheerio": "^1.2.0",
    "marked": "^17.0.4",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
