---
import { getCollection } from 'astro:content';
import BusinessPage from '../../layouts/BusinessPage.astro';
export async function getStaticPaths() {
  return (await getCollection('services')).map(({data:page}) => ({params:{slug:page.slug},props:{page}}));
}
const { page } = Astro.props;
---
<BusinessPage page={page} type="service" />
