---
import { Image } from 'astro:assets';
import homeImage0 from "../../public/images/off-piste-mark-transparent-white.webp";
import homeImage1 from "../../public/images/cases/OtherStuff-new-duplicate.webp";
import homeImage2 from "../../public/images/cases/Supply-Drop-new-duplicate.webp";
import homeImage3 from "../../public/images/cases/Flow-Dynamics.webp";
import homeImage4 from "../../public/images/cases/Decarbonology-new-duplicate.webp";
import homeImage5 from "../../public/images/cases/Place-Intelligence-new-duplicate.webp";
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LatestInsights from '../components/LatestInsights.astro';
---
<SiteLayout bodyAttributes={{"data-page-type":"duplicate-home","data-theme":"dark"}}>
<Fragment slot="head" is:raw>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="description" content="Off Piste Studio creates websites, brands, SEO foundations, and collateral that clarify what you do and convert attention into revenue.">
  <title>Strategic Websites, Branding &amp; SEO | Off Piste Studio</title>
  <meta name="google-site-verification" content="q8VkoKQHRK04D2e_AD5QXcSHnB_BtbYdEL8cxOuROJA">
  <link rel="canonical" href="https://offpistestudio.com/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Strategic Websites, Branding &amp; SEO | Off Piste Studio">
  <meta property="og:description" content="Off Piste Studio creates websites, brands, SEO foundations, and collateral that clarify what you do and convert attention into revenue.">
  <meta property="og:url" content="https://offpistestudio.com/">
  <meta property="og:site_name" content="Off Piste Studio">
  <meta property="og:image" content="https://offpistestudio.com/images/Hero-Background.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Strategic Websites, Branding &amp; SEO | Off Piste Studio">
  <meta name="twitter:description" content="Off Piste Studio creates websites, brands, SEO foundations, and collateral that clarify what you do and convert attention into revenue.">
  <meta name="twitter:image" content="https://offpistestudio.com/images/Hero-Background.png">
  <script type="application/ld+json" is:inline="">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "LocalBusiness",
        "@id": "https://offpistestudio.com/#business",
        "name": "Off Piste Studio",
        "description": "AI-native design and technology studio creating websites, brand systems, SEO foundations, and collateral that help growing businesses earn trust and convert attention into revenue.",
        "url": "https://offpistestudio.com",
        "email": "hello@offpistestudio.com",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "City Beach",
          "addressRegion": "WA",
          "addressCountry": "AU"
        },
        "areaServed": [
          { "@type": "City", "name": "Perth" },
          { "@type": "Country", "name": "Australia" },
          { "@type": "Country", "name": "New Zealand" }
        ],
        "priceRange": "$$",
        "image": "https://offpistestudio.com/images/Hero-Background.png",
        "sameAs": [
          "https://www.linkedin.com/company/off-piste-studio"
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5",
          "reviewCount": "3"
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://offpistestudio.com/#website",
        "name": "Off Piste Studio",
        "url": "https://offpistestudio.com",
        "publisher": { "@id": "https://offpistestudio.com/#business" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://offpistestudio.com/?s={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Organization",
        "@id": "https://offpistestudio.com/#organization",
        "name": "Off Piste Studio",
        "url": "https://offpistestudio.com",
        "logo": "https://offpistestudio.com/images/off-piste-mark-transparent.png",
        "foundingDate": "2020",
        "sameAs": [
          "https://www.linkedin.com/company/off-piste-studio"
        ]
      },
      {
        "@type": "Service",
        "name": "Strategic Website Design",
        "description": "Strategic website design for growing businesses that need clear positioning, strong trust signals, search foundations, and better enquiry quality.",
        "provider": { "@id": "https://offpistestudio.com/#business" },
        "serviceType": "Website Design",
        "areaServed": { "@type": "Country", "name": "Australia" }
      },
      {
        "@type": "Service",
        "name": "Local SEO and Search Visibility",
        "description": "Search visibility services including Google Business Profile setup, local citations, service-page optimisation, structured data, and Google Maps optimisation.",
        "provider": { "@id": "https://offpistestudio.com/#business" },
        "serviceType": "Search Engine Optimisation"
      },
      {
        "@type": "Service",
        "name": "Brand Identity Design",
        "description": "Brand strategy, logo design, visual identity, and brand guidelines for growing businesses and professional firms.",
        "provider": { "@id": "https://offpistestudio.com/#business" },
        "serviceType": "Brand Design"
      },
      {
        "@type": "Review",
        "itemReviewed": { "@id": "https://offpistestudio.com/#business" },
        "reviewRating": { "@type": "Rating", "ratingValue": "5" },
        "author": { "@type": "Person", "name": "Dr. Mariyam Shakeela" },
        "reviewBody": "Their creative approach ensured that our new website not only looks professional but also effectively communicates our commitment to integrating people from various backgrounds into Australian society. It has not only enhanced our online presence but also significantly supported our outreach efforts, allowing us to connect more meaningfully with the communities we serve. We are grateful for Off Piste Studio\u2019s role in helping us establish a strong, impactful presence."
      },
      {
        "@type": "Review",
        "itemReviewed": { "@id": "https://offpistestudio.com/#business" },
        "reviewRating": { "@type": "Rating", "ratingValue": "5" },
        "author": { "@type": "Person", "name": "Tan Tran" },
        "reviewBody": "Off Piste Studio\u2019s know-how was crucial for our rebrand, website design and development and successful go to market. They walked us through the whole process - from market research to creating our new brand identity and overall look. We\u2019re thrilled with the fresh, distinctive brand they\u2019ve helped us build."
      },
      {
        "@type": "Review",
        "itemReviewed": { "@id": "https://offpistestudio.com/#business" },
        "reviewRating": { "@type": "Rating", "ratingValue": "5" },
        "author": { "@type": "Person", "name": "Cameron Edwards" },
        "reviewBody": "Off Piste Studio\u2019s played a key role in our website and brand development. The team responded in a timely manner to requests and pricing was fair. Excellent customer service. We have developed several websites with OPS and we are very happy with their technical support, design and development. OPS is responsive and proactive in developing our online presence and providing the necessary technical expertise we require. We will continue to use Off Piste Studio in the future."
      }
    ]
  }
  </script>
  
  
  
  
  
  
  
  
  
  <style is:global="" is:inline="">
    @media (max-width: 768px) {
      body[data-page-type="duplicate-home"][data-theme="light"] {
        --home-mobile-light-rail: var(--site-divider-light);
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .insights-row--cards {
        background-image: none !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .insights-card,
      body[data-page-type="duplicate-home"][data-theme="light"] .insights-card__content,
      body[data-page-type="duplicate-home"][data-theme="light"] .insights-card__footer {
        border-left: 0 !important;
        border-right: 0 !important;
        background-image: none !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .testimonials__row--logos {
        border-top: 0 !important;
        border-bottom: 1px solid var(--home-mobile-light-rail) !important;
        background-image: linear-gradient(to right, transparent calc(50% - 0.5px), var(--home-mobile-light-rail) calc(50% - 0.5px), var(--home-mobile-light-rail) calc(50% + 0.5px), transparent calc(50% + 0.5px)) !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .testimonials__logo-cell {
        border-left: 0 !important;
        border-right: 0 !important;
        border-bottom: 0 !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .testimonials__logo-cell {
        border-left: 0 !important;
        border-right: 0 !important;
        border-top: 1px solid var(--home-mobile-light-rail) !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .testimonials__logo-cell:nth-child(-n + 2) {
        border-top: 0 !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .testimonials__row--logos > .testimonials__logo-cell,
      body[data-page-type="duplicate-home"][data-theme="light"] .testimonials__row--logos > .testimonials__logo-cell + .testimonials__logo-cell {
        border-left: 0 !important;
        border-right: 0 !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .faq-duplicate__row--title {
        border-bottom: 1px solid var(--home-mobile-light-rail) !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .faq-duplicate__row--blank,
      body[data-page-type="duplicate-home"][data-theme="light"] .faq-duplicate__row--blank-bottom,
      body[data-page-type="duplicate-home"][data-theme="light"] .faq-duplicate .faq__item {
        border-bottom: 0 !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .faq-duplicate__row--blank::after,
      body[data-page-type="duplicate-home"][data-theme="light"] .faq-duplicate__row--blank-bottom::before,
      body[data-page-type="duplicate-home"][data-theme="light"] .faq-duplicate .faq__item::after {
        background: var(--home-mobile-light-rail) !important;
      }

      body[data-page-type="duplicate-home"][data-theme="light"] .faq-duplicate .faq__item:last-child::after {
        content: none !important;
      }
    }
  </style>
</Fragment>
<Fragment is:raw>
  <div class="duplicate-nav-overlay" data-duplicate-nav-overlay="" aria-hidden="true"></div>

  </Fragment><Header /><Fragment is:raw>

  <main>
    <section class="hero-intro">
      
      <div class="container">
        <div class="hero-intro__content">
          </Fragment><Image src={homeImage0} widths={[96, 192]} sizes="82px" format="webp" alt="" class="hero-intro__icon" aria-hidden="true" /><Fragment is:raw>
          <h1 class="hero-intro__title">Websites that work as hard as you.</h1>
          <p class="hero-intro__text">Off Piste Studio is a strategic design partner crafting AI-enabled websites, brands and content that turn your expertise into growth.</p>
          <a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="hero-intro__button">Book a Free Discovery Call</a>
        </div>
        <div class="hero-intro__scroll">
          <span>Swipe to Explore</span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 1V11M6 11L1 6M6 11L11 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </section>

    <section class="client-bar">
      <div class="client-bar__inner">
        <span class="client-bar__text">Trusted by 50+ Clients</span>
        <div class="client-bar__track">
          <div class="client-bar__logos">
            <div class="client-bar__logo-set">
              <img src="/images/logos/PLI Logo Light.webp" alt="Place Intelligence" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/SB Logo Light.webp" alt="Superbeing" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/PLE Logo Light.webp" alt="Pleiades" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/FD Logo Light.webp" alt="Future Directors" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/FDY Logo Light.webp" alt="Flow Dynamics" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/DE Logo Light.webp" alt="Decarbonology" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/BU Logo Light.webp" alt="Buildsource" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/CC Logo Light.webp" alt="Cell Cyber" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/LI Logo Light.webp" alt="Linear" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/new-client-logo.webp" alt="3LINES Group" class="client-bar__logo" loading="eager" decoding="async" width="600" height="300">
            </div>
            <div class="client-bar__logo-set" aria-hidden="true">
              <img src="/images/logos/PLI Logo Light.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/SB Logo Light.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/PLE Logo Light.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/FD Logo Light.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/FDY Logo Light.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/DE Logo Light.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/BU Logo Light.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/CC Logo Light.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/LI Logo Light.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="599" height="299">
              <img src="/images/logos/new-client-logo.webp" alt="" class="client-bar__logo" loading="eager" decoding="async" width="600" height="300">
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="case-studies">
      <div class="container">
        <div class="case-studies__intro">
          <div class="case-studies__intro-meta">
            <h2 class="case-studies__heading">Selected Works</h2>
          </div>
        </div>
        <div class="case-studies__grid">
          <div class="case-studies__row case-studies__row--top">
            <article class="case-card case-card--feature">
              <div class="case-card__image-wrapper">
                <a href="#" class="case-card__image">
                  </Fragment><Image src={homeImage1} widths={[360, 720, 1080]} sizes="(max-width: 768px) 100vw, 50vw" format="webp" alt="Other Stuff website screenshot" /><Fragment is:raw>
                </a>
              </div>
              <div class="case-card__content">
                <div class="case-card__meta">
                  <span class="case-card__label">Other Stuff</span>
                  <div class="case-card__tags">
                    <span>AI</span>
                    <span>SMEs</span>
                    <span>Web</span>
                  </div>
                </div>
                <h3 class="case-card__title">Crafted Other Stuff's new digital presence to deliver practical AI capability for SMEs.</h3>
                <p class="case-card__summary">A sharper digital system built to explain the offer quickly, elevate trust, and turn curiosity about AI into qualified business conversations.</p>
              </div>
            </article>

            <article class="case-card case-card--wide">
              <div class="case-card__image-wrapper">
                <a href="#" class="case-card__image">
                  </Fragment><Image src={homeImage2} widths={[360, 720, 1080]} sizes="(max-width: 768px) 100vw, 50vw" format="webp" alt="Supply Drop website screenshot" loading="lazy" /><Fragment is:raw>
                </a>
              </div>
              <div class="case-card__content">
                <div class="case-card__meta">
                  <span class="case-card__label">Supply Drop</span>
                  <div class="case-card__tags">
                    <span>Brand</span>
                    <span>Web</span>
                  </div>
                </div>
                <h3 class="case-card__title">Created Supply Drop's brand and web presence for a sharper product launch.</h3>
                <p class="case-card__summary">A product-led identity and website system shaped to make the drop feel sharper, more credible, and ready to sell.</p>
              </div>
            </article>
          </div>

          <div class="case-studies__row case-studies__row--bottom">
            <article class="case-card case-card--half">
              <div class="case-card__image-wrapper">
                <a href="#" class="case-card__image">
                  </Fragment><Image src={homeImage3} widths={[360, 720, 1080]} sizes="(max-width: 768px) 100vw, 50vw" format="webp" alt="Flow Dynamics website screenshot" loading="lazy" /><Fragment is:raw>
                </a>
              </div>
              <div class="case-card__content">
                <div class="case-card__meta">
                  <span class="case-card__label">Flow Dynamics</span>
                  <div class="case-card__tags">
                    <span>Brand</span>
                    <span>Web</span>
                  </div>
                </div>
                <h3 class="case-card__title">Built Flow Dynamics' brand and web presence from the ground up.</h3>
              </div>
            </article>

            <article class="case-card case-card--half">
              <div class="case-card__image-wrapper">
                <a href="#" class="case-card__image">
                  </Fragment><Image src={homeImage4} widths={[360, 720, 1080]} sizes="(max-width: 768px) 100vw, 50vw" format="webp" alt="Decarbonology website screenshot" loading="lazy" /><Fragment is:raw>
                </a>
              </div>
              <div class="case-card__content">
                <div class="case-card__meta">
                  <span class="case-card__label">Decarbonology</span>
                  <div class="case-card__tags">
                    <span>Climate Tech</span>
                    <span>Web</span>
                  </div>
                </div>
                <h3 class="case-card__title">Launched Decarbonology's digital presence to accelerate enterprise climate action.</h3>
              </div>
            </article>

            <article class="case-card case-card--half">
              <div class="case-card__image-wrapper">
                <a href="#" class="case-card__image">
                  </Fragment><Image src={homeImage5} widths={[360, 720, 1080]} sizes="(max-width: 768px) 100vw, 50vw" format="webp" alt="Place Intelligence website screenshot" loading="lazy" /><Fragment is:raw>
                </a>
              </div>
              <div class="case-card__content">
                <div class="case-card__meta">
                  <span class="case-card__label">Place Intelligence</span>
                  <div class="case-card__tags">
                    <span>Strategy</span>
                  </div>
                </div>
                <h3 class="case-card__title">Refined Place Intelligence's product and fundraising strategy.</h3>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="between-strip" aria-label="Selected works transition">
      <div class="container">
        <div class="between-strip__grid">
          <div class="between-strip__cell between-strip__cell--left">
            <a href="/work" class="between-strip__link">View all our work</a>
          </div>
          <div class="between-strip__cell between-strip__cell--right"></div>
        </div>
      </div>
    </section>

    <section class="between-strip between-strip--mobile-blank" aria-hidden="true">
      <div class="container">
        <div class="between-strip__grid">
          <div class="between-strip__cell"></div>
        </div>
      </div>
    </section>

    <section class="home-why-placeholder" aria-labelledby="home-why-heading">
      <div class="container">
        <div class="home-why-placeholder__inner">
          <div class="home-why-placeholder__content">
            <h2 class="home-why-placeholder__heading" id="home-why-heading">The cost of looking the same as everyone else keeps going up. We provide the taste, judgement and creativity to turn your expertise into clear signal.</h2>
            <p class="home-why-placeholder__text">Off Piste Studio creates systems that compound value — websites, brands, and collateral that clarify what you do, communicate why it matters, and convert attention into revenue.</p>
            <p class="home-why-placeholder__text">We combine design and technology to help growing companies look sharper, explain their value faster, and turn more of the right attention into revenue.</p>
            <a href="/about" class="hero__button home-why-placeholder__button">About Off Piste</a>
          </div>
        </div>
      </div>
    </section>

    <section class="hero section">
      <div class="container">
        <div class="about-grid">
          <div class="pathways__intro">
            <div class="pathways__intro-cell pathways__intro-cell--title">
              <h2 class="pathways__heading">Your business has outgrown the way it shows up online.</h2>
            </div>
            <div class="pathways__intro-cell pathways__intro-cell--copy">
              <p class="pathways__text">You know your business has more value than your website, brand or content currently shows. We help you close that gap with the right mix of strategy, design and technology, strengthening the moments that shape how buyers see, trust and choose you.</p>
              <a href="/pricing" class="hero__button pathways__button">View Pricing</a>
            </div>
          </div>

          <div class="pathways__list">
            <a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="pathway">
              <div class="pathway__meta">
                <span>(01)</span>
                <span class="pathway__arrow" aria-hidden="true">→</span>
              </div>
              <div class="pathway__body">
                <h3 class="pathway__title">Brand Foundation</h3>
                <p class="pathway__text">For businesses that need clearer positioning, messaging and identity before they ask the market to pay attention.</p>
                <ul class="pathway__details">
                  <li>Brand Strategy</li>
                  <li>Positioning &amp; Messaging</li>
                  <li>Customer &amp; Audience Analysis</li>
                  <li>Visual Identity Design</li>
                  <li>Brand Guidelines</li>
                  <li>Sales &amp; Marketing Collateral</li>
                </ul>
                <span class="pathway__cta">Book a Discovery Call</span>
              </div>
            </a>

            <a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="pathway">
              <div class="pathway__meta">
                <span>(02)</span>
                <span class="pathway__arrow" aria-hidden="true">→</span>
              </div>
              <div class="pathway__body">
                <h3 class="pathway__title">Website + Search</h3>
                <p class="pathway__text">For businesses that need a professional website launched properly, with the search foundations to be found and convert enquiries.</p>
                <ul class="pathway__details">
                  <li>Website Design</li>
                  <li>Website Development</li>
                  <li>UX &amp; Page Structure</li>
                  <li>Technical &amp; On-page SEO</li>
                  <li>AI Search Readiness (GEO)</li>
                  <li>Analytics Setup</li>
                </ul>
                <span class="pathway__cta">Book a Discovery Call</span>
              </div>
            </a>

            <a href="https://cal.com/off-piste-studio/discovery" target="_blank" rel="noopener" class="pathway">
              <div class="pathway__meta">
                <span>(03)</span>
                <span class="pathway__arrow" aria-hidden="true">→</span>
              </div>
              <div class="pathway__body">
                <h3 class="pathway__title">UX/UI Product Design</h3>
                <p class="pathway__text">For teams building digital products, portals or workflows that need clearer interfaces, sharper journeys and a more usable experience.</p>
                <ul class="pathway__details">
                  <li>Product UX Strategy</li>
                  <li>Interface Design</li>
                  <li>User Flows &amp; Wireframes</li>
                  <li>Agent Native Interfaces</li>
                  <li>Agentic Design Systems</li>
