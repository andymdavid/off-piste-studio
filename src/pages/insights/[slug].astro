---
import { getCollection } from 'astro:content';
import { load } from 'cheerio';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { renderMarkdown, createArticleHtml } from '../../lib/insights-renderer.mjs';
export async function getStaticPaths() {
  const format = (date) => new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(`${date}T00:00:00Z`));
  const posts = (await getCollection('insights')).map(({ data }) => ({
    ...data, html: renderMarkdown(data.markdown), displayDate: format(data.date),
    displayUpdatedDate: data.updatedDate ? format(data.updatedDate) : undefined,
  })).sort((a, b) => b.date.localeCompare(a.date));
  return posts.map(post => ({ params: { slug: post.slug }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const $ = load(createArticleHtml(post, posts));
$('head link[rel="stylesheet"], head link[rel="preload"], head link[rel="preconnect"]').remove();
// Related cards already render at build time; no catalogue or client replacement needed.
$('[data-related-posts]').removeAttr('data-related-posts');
---
<SiteLayout bodyAttributes={{ 'data-page-type': 'insight', 'data-insight-slug': post.slug, 'data-theme': 'dark' }}>
  <Fragment slot="head" set:html={$('head').html()} />
  <Header />
  <Fragment set:html={$('body main').toString()} />
  <Footer />
</SiteLayout>
